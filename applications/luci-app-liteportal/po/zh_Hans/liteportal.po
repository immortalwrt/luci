msgid "not an image"
msgstr "非图片"

#: htdocs/luci-static/resources/view/liteportal/assets.js:226
#: htdocs/luci-static/resources/view/liteportal/assets.js:560
msgid "Icons"
msgstr "图标"

#: htdocs/luci-static/resources/view/liteportal/assets.js:227
#: htdocs/luci-static/resources/view/liteportal/assets.js:561
msgid "Backgrounds"
msgstr "背景图"

#: htdocs/luci-static/resources/view/liteportal/assets.js:307
#, javascript-format
msgid "Image is larger than 2 MiB (%s)."
msgstr "图片超过 2 MiB（%s）。"

#: htdocs/luci-static/resources/view/liteportal/assets.js:363
msgid "Upload"
msgstr "上传"

#: htdocs/luci-static/resources/view/liteportal/assets.js:365
msgid "Up to 2 MiB per file."
msgstr "每个文件最大 2 MiB。"

#: htdocs/luci-static/resources/view/liteportal/assets.js:380
#: htdocs/luci-static/resources/view/liteportal/assets.js:408
#: htdocs/luci-static/resources/view/liteportal/assets.js:499
msgid "Rename"
msgstr "重命名"

#: htdocs/luci-static/resources/view/liteportal/assets.js:381
msgid "Choose a new name. Letters, digits, dot, dash and underscore only."
msgstr "请输入新文件名，仅允许字母、数字、点、短横线和下划线。"

#: htdocs/luci-static/resources/view/liteportal/assets.js:396
msgid "Invalid file name."
msgstr "文件名不合法。"

#: htdocs/luci-static/resources/view/liteportal/assets.js:403
#, javascript-format
msgid "Renamed to %s."
msgstr "已重命名为 %s。"

#: htdocs/luci-static/resources/view/liteportal/assets.js:416
#: htdocs/luci-static/resources/view/liteportal/assets.js:438
#: htdocs/luci-static/resources/view/liteportal/assets.js:504
#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:206
msgid "Delete"
msgstr "删除"

#: htdocs/luci-static/resources/view/liteportal/assets.js:417
#, javascript-format
msgid "Delete %s?"
msgstr "确定删除 %s？"

#: htdocs/luci-static/resources/view/liteportal/assets.js:419
msgid "Bookmarks using this file and the current background will be cleared."
msgstr "使用该文件的书签及当前背景设置将被清除。"

#: htdocs/luci-static/resources/view/liteportal/assets.js:462
#, javascript-format
msgid ""
"Background set to %s. Press \"Save & Apply\" below to make it take effect."
msgstr "背景已设为 %s，按下方“保存并应用”后生效。"

#: htdocs/luci-static/resources/view/liteportal/assets.js:486
msgid "(current)"
msgstr "（当前）"

#: htdocs/luci-static/resources/view/liteportal/assets.js:494
msgid "Set as background"
msgstr "设为背景"

#: htdocs/luci-static/resources/view/liteportal/assets.js:517
#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:630
msgid "Name"
msgstr "名称"

#: htdocs/luci-static/resources/view/liteportal/assets.js:518
msgid "Size"
msgstr "大小"

#: htdocs/luci-static/resources/view/liteportal/assets.js:519
msgid "Modified"
msgstr "修改时间"

#: htdocs/luci-static/resources/view/liteportal/assets.js:520
msgid "Actions"
msgstr "操作"

#: htdocs/luci-static/resources/view/liteportal/assets.js:523
msgid "No files yet."
msgstr "暂无文件。"

#: htdocs/luci-static/resources/view/liteportal/assets.js:568
msgid "Assets"
msgstr "素材库"

#: htdocs/luci-static/resources/view/liteportal/assets.js:570
msgid ""
"Icons and background images offered to the portal. Files are served from the "
"portal page directory by the main web server, picked for a bookmark on the "
"Bookmarks page, or set as the page background here."
msgstr ""
"提供给门户使用的图标与背景图。文件由主 Web 服务器从门户页面目录提供，可在「书"
"签」页选作图标，或在此设为页面背景。"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:255
#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:611
msgid "Enabled"
msgstr "启用"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:259
msgid "Select all"
msgstr "全选"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:287
#, javascript-format
msgid "Enabled %d bookmark(s). Press \"Save & Apply\" to keep the change."
msgstr "已启用 %d 个书签，按“保存并应用”以保留此更改。"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:288
#, javascript-format
msgid "Disabled %d bookmark(s). Press \"Save & Apply\" to keep the change."
msgstr "已停用 %d 个书签，按“保存并应用”以保留此更改。"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:414
msgid "More…"
msgstr ""

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:452
msgid "Save this bookmark"
msgstr "保存这一行"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:466
msgid "Saved"
msgstr "已保存"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:469
msgid "Save"
msgstr "保存"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:518
msgid "There is no disabled bookmark to delete."
msgstr "没有已禁用的书签可删除。"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:519
msgid "There is no bookmark to delete."
msgstr "没有书签可删除。"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:525
#, javascript-format
msgid ""
"This removes %d disabled bookmark(s) from the configuration. It cannot be "
"undone."
msgstr "将从配置中删除 %d 个已禁用的书签，此操作不可撤销。"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:526
#, javascript-format
msgid ""
"This removes all %d bookmark(s) from the configuration. It cannot be undone."
msgstr "将从配置中删除全部 %d 个书签，此操作不可撤销。"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:552
msgid "Delete disabled bookmarks"
msgstr "删除禁用书签"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:553
msgid "Clear all bookmarks"
msgstr "清空所有书签"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:583
msgid ""
"The tiles shown on the portal page. Only enabled bookmarks are baked into "
"links.json."
msgstr "门户页上显示的磁贴。只有启用的书签才会被烘焙进 links.json。"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:633
msgid "URL"
msgstr "URL"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:637
msgid "Icon"
msgstr "图标"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:638
msgid "An emoji or an absolute image URL."
msgstr "emoji 或图片的绝对 URL。"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:646
msgid "Icon file"
msgstr "图标文件"

#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:647
msgid "An image from the Assets page. Takes precedence over the icon above."
msgstr "来自「素材库」的图片，优先级高于上方的图标。"

#: htdocs/luci-static/resources/view/liteportal/general.js:20
msgid "Portal"
msgstr "门户"

#: htdocs/luci-static/resources/view/liteportal/general.js:21
msgid ""
"A static HTML portal served by the web server the router already runs, under "
"the /liteportal/ sub-path. Settings are persisted in uci and baked into "
"links.json on apply."
msgstr ""
"由路由器上已在运行的 Web 服务器在 /liteportal/ 子路径下提供的静态 HTML 门户。"
"设置保存在 uci 中，应用时烘焙进 links.json。"

#: htdocs/luci-static/resources/view/liteportal/general.js:27
msgid "General"
msgstr "常规"

#: htdocs/luci-static/resources/view/liteportal/general.js:37
msgid "Enable portal"
msgstr "启用门户"

#: htdocs/luci-static/resources/view/liteportal/general.js:38
msgid ""
"Publish the portal page, or take it off the web server. When off, /"
"liteportal/ stops resolving; the uploaded icons and backgrounds are kept."
msgstr ""
"发布门户页面，或把它从 Web 服务器上撤下。关闭后 /liteportal/ 不再解析；已上传"
"的图标与背景图会保留。"

#: htdocs/luci-static/resources/view/liteportal/general.js:43
msgid "Page title"
msgstr "页面标题"

#: htdocs/luci-static/resources/view/liteportal/general.js:46
msgid "Background colour"
msgstr "背景颜色"

#: htdocs/luci-static/resources/view/liteportal/general.js:47
msgid "A CSS colour value such as #0e1116."
msgstr "CSS 颜色值，例如 #0e1116。"

#: htdocs/luci-static/resources/view/liteportal/general.js:55
msgid "Current background image"
msgstr "当前背景图片"

#: htdocs/luci-static/resources/view/liteportal/general.js:56
msgid "Chosen on the Assets page. It takes precedence over the colour."
msgstr "在「素材库」页选择，优先级高于背景颜色。"

#: htdocs/luci-static/resources/view/liteportal/general.js:60
msgid "none"
msgstr "无"

#: htdocs/luci-static/resources/view/liteportal/general.js:82
msgid "Background veil"
msgstr "背景遮罩强度"

#: htdocs/luci-static/resources/view/liteportal/general.js:83
msgid ""
"How strongly a background image is dimmed, in percent. 0 leaves the photo as "
"it is, 100 hides it behind a solid scrim. Only applies when a background "
"image is set."
msgstr ""
"背景图被压暗的程度（百分比）。0 表示保持照片原样，100 表示用纯色遮罩完全盖"
"住。仅在设置了背景图时生效。"

#: htdocs/luci-static/resources/view/liteportal/general.js:92
msgid "Background blur"
msgstr "背景磨砂模糊"

#: htdocs/luci-static/resources/view/liteportal/general.js:93
msgid ""
"Frosted-glass blur applied to a background image, in percent of the maximum "
"(20 px). 0 keeps the photo sharp."
msgstr ""
"对背景图施加的磨砂模糊，以最大值（20 px）的百分比表示。0 表示照片保持清晰。"

#: htdocs/luci-static/resources/view/liteportal/general.js:102
msgid "Bookmark transparency"
msgstr "书签透明度"

#: htdocs/luci-static/resources/view/liteportal/general.js:103
msgid ""
"Transparency of the bookmark cards, in percent. 0 makes them solid, 100 lets "
"the background shine through completely; the text stays readable either way."
msgstr ""
"书签卡片的透明度（百分比）。0 表示完全不透明，100 表示背景完全透出；两种取值"
"下文字都保持可读。"

#: htdocs/luci-static/resources/view/liteportal/general.js:121
msgid "Search box"
msgstr "搜索框"

#: htdocs/luci-static/resources/view/liteportal/general.js:122
msgid "Show a search box on the portal page; press Space to summon it."
msgstr "在门户页上显示搜索框，按空格键唤出。"

#: htdocs/luci-static/resources/view/liteportal/general.js:134
msgid "Search engine"
msgstr "搜索引擎"

#: htdocs/luci-static/resources/view/liteportal/general.js:135
msgid "Google"
msgstr "Google"

#: htdocs/luci-static/resources/view/liteportal/general.js:136
msgid "Bing"
msgstr "Bing"

#: htdocs/luci-static/resources/view/liteportal/general.js:137
msgid "DuckDuckGo"
msgstr "DuckDuckGo"

#: htdocs/luci-static/resources/view/liteportal/general.js:138
msgid "Baidu"
msgstr "百度"

#: htdocs/luci-static/resources/view/liteportal/general.js:139
msgid "Custom…"
msgstr "自定义…"

#: htdocs/luci-static/resources/view/liteportal/general.js:156
msgid "Custom search URL"
msgstr "自定义搜索 URL"

#: htdocs/luci-static/resources/view/liteportal/general.js:157
#, javascript-format
msgid "The results URL of your engine, with %s where the keyword goes."
msgstr "引擎的结果页 URL，用 %s 表示搜索关键字。"

#: htdocs/luci-static/resources/view/liteportal/general.js:164
msgid "A custom search URL is required while \"Custom\" is the chosen engine."
msgstr "选择「自定义」引擎时，必须填写自定义搜索 URL。"

#: htdocs/luci-static/resources/view/liteportal/general.js:167
#, javascript-format
msgid ""
"Must be an http(s) URL containing %s as the placeholder for the keyword."
msgstr "必须是 http(s) URL，且包含表示搜索关键字的 %s 占位符。"

