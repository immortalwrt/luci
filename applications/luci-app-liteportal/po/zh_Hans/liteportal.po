#: htdocs/luci-static/resources/liteportal/common.js:352
msgid "The page files are not in place. Press \"Save & Apply\" to publish it."
msgstr "页面文件尚未就位。点「保存并应用」发布它。"

#: htdocs/luci-static/resources/liteportal/common.js:355
msgid ""
"The main web server (uhttpd) is not listening on any of its ports, so "
"nothing can serve the page."
msgstr ""
"主 Web 服务器（uhttpd）没有在它的任何端口上监听，因此没有服务能提供这个页面。"

#: htdocs/luci-static/resources/liteportal/common.js:357
msgid "The page cannot be reached."
msgstr "页面无法访问。"

#: htdocs/luci-static/resources/liteportal/common.js:371
msgid "Service state unknown."
msgstr "服务状态未知。"

#: htdocs/luci-static/resources/liteportal/common.js:385
msgid "Reachable"
msgstr "可访问"

#: htdocs/luci-static/resources/liteportal/common.js:387
msgid "Yes"
msgstr "是"

#: htdocs/luci-static/resources/liteportal/common.js:387
msgid "No"
msgstr "否"

#: htdocs/luci-static/resources/liteportal/common.js:390
msgid "Disabled"
msgstr "已停用"

#: htdocs/luci-static/resources/liteportal/common.js:391
msgid "Address"
msgstr "访问地址"

#: htdocs/luci-static/resources/liteportal/common.js:393
