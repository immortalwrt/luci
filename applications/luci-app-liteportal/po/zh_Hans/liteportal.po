#: htdocs/luci-static/resources/view/liteportal/bookmarks.js:607
msgid "Bookmarks"
msgstr "书签"

#: htdocs/luci-static/resources/liteportal/common.js:394
#, javascript-format
msgid "%d baked into links.json"
msgstr "已生成 %d 个书签到 links.json"

#: htdocs/luci-static/resources/liteportal/common.js:395
msgid "links.json has not been generated yet"
msgstr "links.json 尚未生成"

#: htdocs/luci-static/resources/liteportal/common.js:401
msgid ""
"The portal is switched off. Turn on \"Enable portal\" above, then press "
"\"Save & Apply\" to publish it."
msgstr "门户已关闭。请打开上方的「启用门户」，再点「保存并应用」发布它。"

#: htdocs/luci-static/resources/liteportal/common.js:414
#: htdocs/luci-static/resources/liteportal/common.js:421
msgid "Querying…"
msgstr "查询中…"

#: htdocs/luci-static/resources/liteportal/common.js:427
#, javascript-format
