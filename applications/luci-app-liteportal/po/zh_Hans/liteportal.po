msgstr "状态查询失败：%s"

#: htdocs/luci-static/resources/liteportal/common.js:432
msgid "Service status"
msgstr "运行状态"

#: htdocs/luci-static/resources/liteportal/common.js:441
msgid "Refresh"
msgstr "刷新"

#: htdocs/luci-static/resources/liteportal/common.js:444
msgid "Re-reads the published state, it does not change the configuration."
msgstr "仅重新读取发布状态，不会修改配置。"

#: htdocs/luci-static/resources/liteportal/common.js:484
msgid "Maintenance"
msgstr "维护"

#: htdocs/luci-static/resources/liteportal/common.js:490
msgid "Discovery"
msgstr "服务发现"

#: htdocs/luci-static/resources/liteportal/common.js:491
msgid "Scan local services & add (disabled)"
msgstr "扫描本地服务并添加（默认禁用）"

#: htdocs/luci-static/resources/liteportal/common.js:505
msgid "No new local services found."
msgstr "未发现新的本地服务。"

