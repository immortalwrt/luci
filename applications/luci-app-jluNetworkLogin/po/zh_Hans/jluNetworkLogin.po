msgid "Cancel"
msgstr "取消"

msgid "Connection state"
msgstr "连接状态"

msgid "Continue"
msgstr "继续"

msgid "Enable"
msgstr "启用"

msgid "Failed to reload the network: %s"
msgstr "网络重载失败：%s"

msgid "Failed to restart dnsmasq: %s"
msgstr "重启 dnsmasq 失败：%s"

msgid "Fetching challenge"
msgstr "获取挑战中"

msgid "Fill in these fields first: %s"
msgstr "请先填写：%s"

msgid "Gateway"
msgstr "网关"

msgid "IP address"
msgstr "IP 地址"

msgid "IP address is required"
msgstr "未填写 IP 地址"

msgid "Idle"
msgstr "空闲"

msgid "Interface"
msgstr "接口"

msgid "JLU Network Login"
msgstr "吉林大学校园网自动登录"

msgid "Keeping alive"
msgstr "保持在线"

msgid "Last error"
msgstr "最近错误"

msgid "Logging in"
msgstr "登录中"

msgid "MAC address"
msgstr "MAC 地址"

msgid "MAC address is required"
msgstr "未填写 MAC 地址"

msgid "Manual reconnect"
msgstr "手动重连"

msgid "Network interface \"%s\" not found"
msgstr "未找到网络接口“%s”"

msgid "No backup found - run the one-click setup first."
msgstr "未找到备份，请先执行“一键配置”。"

msgid "One-click restore"
msgstr "一键恢复"

msgid "One-click setup"
msgstr "一键配置"

msgid "One-click setup applied (static IP, MAC address, gateway and DNS are set, DNS rebind protection is disabled)."
msgstr "一键配置已应用（静态 IP/MAC/网关/DNS + 关闭 DNS 重绑定保护）。"

msgid "Online"
msgstr "已在线"

msgid "Password"
msgstr "密码"

msgid "Password is required"
msgstr "未填写密码"

msgid "Reconnect"
msgstr "重连"

msgid "Reconnect failed: %s"
msgstr "重连失败：%s"

msgid "Restore applied."
msgstr "恢复已应用。"

msgid "Restore the previous settings?"
msgstr "确认恢复设置？"

msgid "Service is disabled"
msgstr "服务未启用"

msgid "Service not running"
msgstr "服务未运行"

msgid "Service status"
msgstr "服务状态"

msgid "The login service is authenticating again now. Check \"logread -e jlu-network-login\" for details."
msgstr "登录服务正在重新认证。详情看 \"logread -e jlu-network-login\"。"

msgid "The service is disabled - enable it and apply the settings first."
msgstr "服务未启用 —— 请先启用并保存设置。"

msgid "This restores the interface settings that were backed up before the last one-click setup and re-enables DNS rebind protection."
msgstr "这将恢复上次“一键配置”前备份的接口设置，并重新启用 DNS 重绑定保护。"

msgid "Username"
msgstr "账号"

msgid "Username is required"
msgstr "未填写账号"

msgid "the login service is not running (no ubus object) - start it with \"/etc/init.d/jlu-network-login restart\""
msgstr "登录服务未运行（ubus 里没有该对象）—— 用 \"/etc/init.d/jlu-network-login restart\" 启动"

msgid "unknown error"
msgstr "未知错误"
